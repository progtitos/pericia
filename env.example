# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key   # usada apenas em Server Actions/API Routes, nunca no client

# --- Google Gemini ---
GOOGLE_GEMINI_API_KEY=sua_api_key
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash

# --- BACEN (Sistema Gerenciador de Séries Temporais) ---
# Não exige key - API pública. URL base mantida aqui para fácil configuração/mocking em testes.
BACEN_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# --- Mercado Pago (hook para assinaturas futuras) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Segurança / LGPD ---
ENABLE_ANONYMIZATION_BEFORE_AI=true   # Se true, aplica máscara de CPF/nome antes de enviar texto ao Gemini
